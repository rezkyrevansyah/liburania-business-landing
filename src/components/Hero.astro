---
import { Picture } from 'astro:assets';
import { contactUrl, cta } from '../data/site';
import { sectors } from '../data/sectors';

const [fnb, retail, service] = sectors;
const behind = ['Pesanan', 'Bahan', 'Stok', 'Jadwal', 'Komisi', 'Laporan'];
const tiles = [
  { s: fnb, crop: '58% 45%', cls: 'col-span-2 aspect-[16/10] lg:col-span-1 lg:row-span-2 lg:aspect-auto', sizes: '(min-width: 1024px) 34vw, 100vw', i: 0 },
  { s: retail, crop: '55% 30%', cls: 'aspect-[4/3.6] lg:aspect-auto', sizes: '(min-width: 1024px) 22vw, 50vw', i: 1 },
  { s: service, crop: '30% 40%', cls: 'aspect-[4/3.6] lg:aspect-auto', sizes: '(min-width: 1024px) 22vw, 50vw', i: 2 },
];
---

<section id="top" aria-labelledby="hero-title" class="pt-8 pb-16 md:pt-12 md:pb-24 lg:pt-14">
  <div class="shell grid items-center gap-10 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] lg:gap-14">
    <div class="max-w-xl">
      <p class="hero-rise flex items-center gap-3 text-[0.9375rem] font-semibold text-muted" style="--i:0">
        <span aria-hidden="true" class="flex gap-1">
          <span class="size-2 rounded-[2px] bg-blue"></span>
          <span class="size-2 rounded-[2px] bg-cyan"></span>
          <span class="size-2 rounded-[2px] bg-navy"></span>
        </span>
        Sistem operasional untuk F&B, retail, dan jasa
      </p>
      <h1
        id="hero-title"
        class="hero-rise mt-5 text-[clamp(2.5rem,1.1rem+4.4vw,4.5rem)] font-[760] tracking-[-0.035em]"
        style="--i:1"
      >
        <span class="block">Usaha berjalan.</span>
        <span class="block">Anda pegang kendali.</span>
      </h1>
      <p class="hero-rise mt-6 max-w-[34rem] text-lg leading-[1.6] text-muted md:text-[1.1875rem]" style="--i:2">
        Dari kasir hingga laporan, pilih solusi Liburania Business untuk F&B, retail, atau jasa yang membantu
        operasional usaha Anda lebih tertata.
      </p>
      <div class="hero-rise mt-8 flex flex-col gap-3 sm:flex-row" style="--i:3" data-hero-cta>
        <a href={contactUrl} class="btn btn-primary" data-track="demo_click" data-section="hero">{cta.demo}</a>
        <a href={contactUrl} class="btn btn-quiet" data-track="sales_click" data-section="hero">{cta.sales}</a>
      </div>
      <a
        href="#solusi"
        class="hero-rise group mt-7 inline-flex items-center gap-2 text-[0.9375rem] font-semibold text-blue"
        style="--i:4"
      >
        Temukan solusi untuk usaha Anda
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          class="size-4 transition-transform duration-200 group-hover:translate-y-0.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"><path d="M5 8l5 5 5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
      </a>
    </div>

    <div>
      <ul class="grid grid-cols-2 gap-3 lg:h-[clamp(460px,44vw,560px)] lg:grid-cols-[1.45fr_1fr] lg:grid-rows-2">
        {
          tiles.map(({ s, crop, cls, sizes, i }) => (
            <li class:list={['hero-unveil', cls]} style={`--i:${i}`}>
              <a
                href={`#solusi-${s.id}`}
                data-sector-link={s.id}
                class="group relative block h-full overflow-hidden rounded-[var(--radius-photo)] bg-line"
              >
                <Picture
                  src={s.photo}
                  alt=""
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  widths={i === 0 ? [640, 960, 1280] : [400, 640, 900]}
                  sizes={sizes}
                  loading="eager"
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  class="photo transition-transform duration-700 ease-[var(--ease-out-soft)] group-hover:scale-[1.03]"
                  style={`object-position:${crop}`}
                />
                <span class="absolute bottom-3 left-3 flex items-baseline gap-2 rounded-[10px] bg-white/95 px-3 py-2 shadow-[0_1px_2px_rgb(7_28_61/0.12)] backdrop-blur">
                  <span class="text-[0.9375rem] font-bold">{s.tab}</span>
                  <span class="hidden text-sm text-muted sm:inline">{s.audienceShort}</span>
                  <span class="sr-only">, lihat solusi</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div
        class="hero-rise mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-2xl bg-navy px-5 py-4 text-white"
        style="--i:5"
      >
        <p class="text-sm font-semibold text-cyan">Di balik setiap pelayanan</p>
        <ul
          class="grid w-full grid-cols-3 gap-x-4 gap-y-1 text-sm text-white/80 sm:flex sm:w-auto sm:flex-wrap"
          aria-label="Yang dikelola di balik pelayanan"
        >
          {
            behind.map((item) => (
              <li class="sm:border-l sm:border-white/20 sm:pl-4 sm:first:border-0 sm:first:pl-0">{item}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
