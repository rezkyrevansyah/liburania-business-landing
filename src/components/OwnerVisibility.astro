---
import { sectors } from '../data/sectors';
---

<section aria-labelledby="owner-title" class="bg-white py-16 md:py-24 lg:py-28">
  <div class="shell">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
      <h2 id="owner-title" class="max-w-[14ch] text-[clamp(2rem,1.2rem+2.6vw,3.25rem)] font-[740]">
        Lebih jelas melihat usaha Anda.
      </h2>
      <p class="max-w-md text-muted lg:pb-1.5">
        Pantau transaksi dan performa operasional melalui laporan yang sesuai dengan kebutuhan usaha.
      </p>
    </div>

    <div
      data-owner-switch
      role="group"
      aria-label="Tampilkan laporan untuk"
      class="mt-10 hidden w-fit gap-1 rounded-[14px] bg-paper p-1 md:mt-12 [.js_&]:flex"
    >
      {
        sectors.map((s, i) => (
          <button
            type="button"
            data-switch={s.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="min-h-11 rounded-[11px] px-4 text-[0.9375rem] font-semibold text-muted transition-colors duration-200 hover:text-navy aria-pressed:bg-navy aria-pressed:text-white"
          >
            {s.tab}
          </button>
        ))
      }
    </div>

    <div class="mt-8 space-y-14 [.js_&]:grid [.js_&]:space-y-0">
      {
        sectors.map((s, i) => (
          <div
            data-owner-panel={s.id}
            data-inactive={i === 0 ? undefined : ''}
            class="grid items-center gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16"
          >
            <div>
              <p class="text-[0.9375rem] font-semibold text-blue">Pertanyaan pemilik {s.tab}</p>
              <p class="mt-3 text-[clamp(1.75rem,1.2rem+1.8vw,2.75rem)] leading-[1.12] font-[720] tracking-[-0.03em] text-balance">
                {s.owner.question}
              </p>
              <p class="mt-5 max-w-[40ch] text-muted">
                <span class="font-semibold text-navy">Fokus laporan:</span> {s.owner.focus.toLowerCase()}.
              </p>
            </div>

            <figure class="rounded-[var(--radius-photo)] border border-line bg-paper/60 p-5 sm:p-7">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <p class="font-bold">
                  Laporan {s.tab}
                  <span class="font-medium text-muted"> / {s.owner.chartTitle.toLowerCase()}</span>
                </p>
                <span class="rounded-full border border-dashed border-muted/50 px-3 py-1 text-xs font-semibold text-muted">
                  Data ilustrasi
                </span>
              </div>
              <ul class="mt-6 space-y-3.5" aria-label={`${s.owner.chartTitle}, data ilustrasi`}>
                {s.owner.bars.map((bar, n) => (
                  <li class="grid grid-cols-[7.5rem_1fr] items-center gap-4 text-[0.9375rem] sm:grid-cols-[9rem_1fr]">
                    <span class="truncate text-muted">{bar.label}</span>
                    <span class="h-3 overflow-hidden rounded-full bg-line/70">
                      <span
                        class:list={['block h-full rounded-full', n === 0 ? 'bg-blue' : 'bg-navy/75']}
                        style={`width:${bar.value}%`}
                      />
                    </span>
                  </li>
                ))}
              </ul>
              <dl class="mt-7 divide-y divide-line border-t border-line">
                {s.owner.rows.map((row) => (
                  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3.5">
                    <dt class="font-semibold">{row.label}</dt>
                    <dd class="text-[0.9375rem] text-muted">{row.note}</dd>
                  </div>
                ))}
              </dl>
              <figcaption class="mt-2 text-xs text-muted">
                Gambaran jenis laporan untuk modul {s.product}. Bukan tampilan atau hasil aplikasi.
              </figcaption>
            </figure>
          </div>
        ))
      }
    </div>
  </div>
</section>
