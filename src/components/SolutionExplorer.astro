---
import { Image, Picture } from 'astro:assets';
import { demoUrlFor, cta } from '../data/site';
import { sectors } from '../data/sectors';
---

<section id="solusi" aria-labelledby="solusi-title" class="pt-14 pb-16 md:pt-20 md:pb-24 lg:pb-28">
  <div data-reveal class="shell">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
      <h2
        id="solusi-title"
        tabindex="-1"
        class="max-w-[16ch] text-[clamp(2rem,1.2rem+2.6vw,3.25rem)] font-[740] outline-none"
      >
        Solusi yang tersedia untuk usaha Anda.
      </h2>
      <p class="max-w-md text-muted lg:pb-1.5">
        Pilih jenis usaha untuk melihat fitur yang tersedia, siapa penggunanya, dan alur kerjanya.
      </p>
    </div>

    <!-- Tab hanya muncul jika JavaScript aktif; tanpa JS ketiga panel tampil berurutan. -->
    <div
      role="tablist"
      data-tablist
      aria-label="Pilih jenis usaha"
      class="mt-10 hidden grid-cols-3 gap-2 rounded-[18px] border border-line bg-white/60 p-1.5 md:mt-12 [.js_&]:grid"
    >
      {
        sectors.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${s.id}`}
            data-tab={s.id}
            aria-controls={`solusi-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="group flex min-h-14 items-center justify-center gap-3 rounded-[13px] px-2 py-2 text-center transition-[background-color,box-shadow] duration-200 hover:bg-white aria-selected:bg-white aria-selected:shadow-[0_0_0_1.5px_var(--color-navy)] sm:justify-start sm:px-3"
          >
            <Image
              src={s.photo}
              alt=""
              widths={[96]}
              sizes="48px"
              class="hidden size-10 shrink-0 rounded-[10px] object-cover sm:block md:size-12"
              style={`object-position:${s.panelCrop}`}
            />
            <span class="min-w-0 text-center sm:text-left">
              <span class="block text-base font-bold md:text-lg">{s.tab}</span>
              <span class="hidden truncate text-sm text-muted group-aria-selected:text-navy/70 lg:block">
                {s.audienceShort}
              </span>
            </span>
          </button>
        ))
      }
    </div>

    <div data-panels class="mt-6 space-y-16 md:mt-8 [.js_&]:grid [.js_&]:space-y-0">
      {
        sectors.map((s, i) => (
          <article
            id={`solusi-${s.id}`}
            data-panel={s.id}
            data-inactive={i === 0 ? undefined : ''}
            aria-labelledby={`panel-title-${s.id}`}
          >
            <div class="grid overflow-clip rounded-[var(--radius-panel)] bg-navy lg:grid-cols-[1.05fr_1fr]">
              <!-- Depan usaha (foto) dan sistem di baliknya (layar) dalam satu bidang: layar menempel di sudut, tepat di batas kolom sistem. -->
              <div class="relative lg:min-h-[640px]">
                <div class="panel-photo relative aspect-[5/4] overflow-clip sm:aspect-[16/10] lg:absolute lg:inset-0 lg:aspect-auto">
                  <Picture
                    src={s.photo}
                    alt={s.photoAlt}
                    formats={['avif', 'webp']}
                    fallbackFormat="jpg"
                    widths={[640, 960, 1280]}
                    sizes="(min-width: 1024px) 50vw, 100vw"
                    class="photo parallax absolute inset-0"
                    style={`object-position:${s.panelCrop}`}
                  />
                  <p class="absolute top-4 left-4 hidden max-w-[calc(100%-2rem)] sm:block rounded-[12px] bg-white/95 px-3.5 py-2 text-sm leading-snug text-navy backdrop-blur sm:max-w-sm">
                    <span class="font-semibold text-blue-deep">Untuk</span> {s.audience}
                  </p>
                </div>

                <figure class="panel-ui relative z-10 mx-4 -mt-10 sm:mx-8 sm:-mt-24 lg:absolute lg:right-0 lg:bottom-0 lg:m-0 lg:w-[94%]">
                  <div class="rounded-[16px] bg-white/14 p-1.5 shadow-[0_-24px_60px_-24px_rgb(7_28_61/0.7)] ring-1 ring-white/25 backdrop-blur-md lg:rounded-none lg:rounded-tl-[22px] lg:p-2 lg:pr-0 lg:pb-0">
                    <Picture
                      src={s.ui}
                      alt={s.uiAlt}
                      formats={['avif', 'webp']}
                      fallbackFormat="jpg"
                      widths={[640, 960, 1280, 1586]}
                      sizes="(min-width: 1024px) 48vw, 92vw"
                      class="block h-auto w-full rounded-[11px] lg:rounded-none lg:rounded-tl-[15px]"
                    />
                  </div>
                  <figcaption class="absolute -top-3.5 left-5 rounded-full bg-cyan px-3 py-1 text-xs font-bold text-navy shadow-sm lg:left-6">
                    Di balik layar · {s.uiLabel}
                  </figcaption>
                </figure>
              </div>

              <div class="on-dark flex flex-col p-6 text-white sm:p-8 lg:p-12">
                <h3 id={`panel-title-${s.id}`}>
                  <span class="block text-[0.9375rem] font-semibold tracking-normal text-cyan">{s.product}</span>
                  <span class="mt-3 block text-[clamp(1.625rem,1.1rem+1.5vw,2.375rem)] font-[720]">{s.headline}</span>
                </h3>
                <p class="mt-4 mb-8 max-w-[46ch] text-white/75">{s.description}</p>

                <div class="mt-8 border-t border-white/12 pt-7 lg:mt-auto">
                  <p class="text-sm font-semibold text-white/60">Fitur yang tersedia</p>
                  <ul class="mt-4 divide-y divide-white/10 border-y border-white/10">
                    {s.features.map((f) => (
                      <li class="flex items-center gap-3 py-2.5 font-medium leading-snug">
                        <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4 shrink-0 text-cyan" fill="none" stroke="currentColor" stroke-width="2.4">
                          <path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                        {f}
                      </li>
                    ))}
                  </ul>
                  <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
                    <a
                      href={demoUrlFor(s.product)}
                      target="_blank"
                      rel="noopener"
                      class="btn btn-primary"
                      data-track="demo_click"
                      data-section="solusi"
                      data-sector={s.id}>{cta.demo} {s.tab}</a
                    >
                    <a href="#harga" class="font-semibold text-white underline underline-offset-4">Mulai Rp149.000/bulan</a>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-4 rounded-[18px] bg-white p-5 sm:p-6 lg:p-8">
              <p class="text-sm font-semibold text-blue">Cocok untuk</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {s.useCases.map((u) => (
                  <li class="rounded-full bg-paper px-3 py-1.5 text-[0.9375rem] font-medium">{u}</li>
                ))}
              </ul>

            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
