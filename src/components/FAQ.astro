---
import { contactUrl, cta } from '../data/site';

// Pertanyaan dan jawaban dari materi owner (Materi_Lengkap_Liburania_Business.md).
const faqs = [
  { q: 'Apakah cocok untuk bisnis kecil?', a: 'Ya. Liburania Business mendukung usaha yang baru berkembang.' },
  { q: 'Apakah bisa untuk beberapa cabang?', a: 'Ya. Anda bisa mengelola dan mengevaluasi beberapa outlet dalam satu sistem.' },
  { q: 'Apakah tersedia sistem kasir dan pengelolaan stok?', a: 'Ya. Solusi F&B, Retail, dan Jasa & Layanan menyediakan fitur kasir dan pengelolaan stok.' },
  { q: 'Apakah bisnis F&B bisa memakai sistem dapur?', a: 'Ya. Kitchen Display System membantu memantau pesanan di dapur.' },
  { q: 'Apakah tersedia booking dan komisi karyawan?', a: 'Ya. Solusi Jasa & Layanan mencakup booking, jadwal staf, dan komisi staf.' },
  { q: 'Apakah tersedia laporan penjualan?', a: 'Ya. Dashboard dan laporan bisnis membantu Anda memantau penjualan.' },
  { q: 'Apakah ada biaya bulanan?', a: 'Ya. Harga mulai Rp149.000 per bulan.' },
  {
    q: 'Bagaimana mendapatkan demo dan konsultasi?',
    a: 'Pilih Jadwalkan Demo atau konsultasikan kebutuhan bisnis Anda melalui WhatsApp.',
  },
]
---

<section id="faq" aria-labelledby="faq-title" class="border-t border-line py-16 md:py-24 lg:py-28">
  <div data-reveal class="shell grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h2 id="faq-title" class="max-w-[12ch] text-[clamp(2rem,1.2rem+2.6vw,3.25rem)] font-[740]">
        Pertanyaan yang sering diajukan
      </h2>
      <p class="mt-5 max-w-sm text-muted">Belum menemukan jawabannya?</p>
      <a
        href={contactUrl}
        target="_blank"
        rel="noopener"
        class="btn btn-quiet mt-5"
        data-track="consult_click"
        data-section="faq">{cta.consult}</a
      >
    </div>
    <div class="border-t border-navy">
      {
        faqs.map((item) => (
          <details class="group border-b border-line">
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-semibold tracking-[-0.01em] [&::-webkit-details-marker]:hidden md:py-6">
              {item.q}
              <span
                aria-hidden="true"
                class="relative grid size-8 shrink-0 place-items-center rounded-full border border-line transition-colors duration-300 group-open:border-navy group-open:bg-navy group-open:text-white"
              >
                <svg viewBox="0 0 16 16" class="size-3.5 transition-transform duration-300 ease-[var(--ease-out-soft)] group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M8 2v12M2 8h12" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <p class="max-w-[62ch] pb-6 text-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
