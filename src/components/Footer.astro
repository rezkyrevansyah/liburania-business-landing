---
import Logo from './Logo.astro';
import { aboutUrl, contactUrl, nav, whatsappDisplay } from '../data/site';
---

<footer data-footer class="on-dark border-t border-white/10 bg-navy text-white">
  <div class="shell grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <a
        href={aboutUrl}
        target="_blank"
        rel="noopener"
        class="inline-block rounded-md"
        aria-label="Liburania Business, buka halaman Liburania Business (tab baru)"
      >
        <Logo tone="white" loading="lazy" />
      </a>
      <p class="mt-4 max-w-xs text-sm text-white/60">
        Sistem bisnis untuk usaha F&B, retail, serta jasa dan layanan.
      </p>
    </div>
    <div>
      <p class="text-sm font-semibold text-white">Kontak</p>
      <p class="mt-3 text-sm text-white/75">
        WhatsApp
        <a href={contactUrl} target="_blank" rel="noopener" class="block font-semibold text-white hover:text-cyan"
          >{whatsappDisplay}</a
        >
      </p>
    </div>
    <nav aria-label="Tautan halaman">
      <p class="text-sm font-semibold text-white">Tautan</p>
      <ul class="mt-3 grid grid-cols-2 gap-x-6 gap-y-2 text-sm text-white/75">
        <li><a href="#top" class="transition-colors hover:text-white">Beranda</a></li>
        <li><a href={aboutUrl} target="_blank" rel="noopener" class="transition-colors hover:text-white">Tentang Liburania</a></li>
        {
          nav.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="shell border-t border-white/10 py-6 text-xs text-white/50">© 2026 Liburania Business</div>
</footer>
