---
import Logo from './Logo.astro';
import { officialLinks } from '../data/site';
---

<footer data-footer class="on-dark border-t border-white/10 bg-navy text-white">
  <div class="shell flex flex-col gap-8 py-10 md:flex-row md:items-start md:justify-between">
    <div>
      <Logo tone="white" />
      <p class="mt-4 max-w-xs text-sm text-white/60">Solusi operasional untuk usaha F&B, retail, dan jasa.</p>
    </div>
    <nav aria-label="Tautan resmi">
      <ul class="grid gap-x-10 gap-y-3 text-sm text-white/75 sm:grid-cols-2">
        {
          officialLinks.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="shell border-t border-white/10 py-6 text-xs text-white/50">© 2026 Liburania Business</div>
</footer>
