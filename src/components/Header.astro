---
import Logo from './Logo.astro';
import { demoUrl, cta, nav, aboutUrl } from '../data/site';
---

<header
  data-header
  class="sticky top-0 z-40 border-b border-transparent bg-paper/85 backdrop-blur-md transition-colors duration-200 data-[scrolled]:border-line"
>
  <div class="shell flex h-16 items-center justify-between gap-6 md:h-[72px]">
    <a href={aboutUrl} class="rounded-md" aria-label="Liburania Business, buka halaman Liburania Business">
      <Logo />
    </a>
    <nav aria-label="Navigasi utama" class="hidden md:block">
      <ul class="flex items-center gap-8 text-[0.9375rem] font-medium text-muted">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                data-nav-link
                class="relative py-1.5 transition-colors duration-200 after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:rounded-full after:bg-blue after:transition-transform after:duration-200 after:content-[''] hover:text-navy aria-[current=location]:font-semibold aria-[current=location]:text-blue-deep aria-[current=location]:after:scale-x-100"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a
      href={demoUrl}
      target="_blank" rel="noopener"
      class="btn btn-primary min-h-11 px-4 text-[0.9375rem]"
      data-header-cta
      data-track="demo_click"
      data-section="header">{cta.demo}</a
    >
  </div>
</header>
