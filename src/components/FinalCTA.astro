---
import { contactUrl, demoUrl, demoUrlFor, cta, price } from '../data/site';
import { sectors } from '../data/sectors';
---

<section id="konsultasi" data-final-cta aria-labelledby="final-title" class="on-dark bg-navy text-white">
  <div data-reveal class="shell py-20 md:py-28">
    <div class="max-w-3xl">
      <p class="text-sm font-bold tracking-[0.08em] text-cyan">
        JELAS HARGANYA. JELAS FITURNYA. JELAS MANFAATNYA.
      </p>
      <h2 id="final-title" class="mt-5 text-[clamp(2.25rem,1.3rem+3.4vw,4rem)] font-[760] tracking-[-0.035em]">
        Jangan tunggu bisnis Anda semakin rumit untuk mulai menggunakan sistem.
      </h2>
      <p class="mt-6 max-w-[52ch] text-lg text-white/75">
        Mulai rapikan operasional bisnis Anda dengan sistem yang jelas fitur, jelas manfaat, dan jelas harganya.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener"
          class="btn btn-primary"
          data-track="demo_click"
          data-section="penutup">{cta.demo}</a
        >
        <a
          href={contactUrl}
          target="_blank"
          rel="noopener"
          class="btn btn-ghost-light"
          data-track="consult_click"
          data-section="penutup">{cta.consult}</a
        >
      </div>
    </div>
    <ul class="mt-16 grid gap-px overflow-hidden rounded-2xl bg-white/10 sm:grid-cols-3 md:mt-20">
      {
        sectors.map((s) => (
          <li class="flex flex-col bg-navy p-5 sm:p-6">
            <p class="font-bold">{s.product}</p>
            <p class="mt-1 text-sm text-white/65">Mulai {price} / bulan</p>
            <a
              href={demoUrlFor(s.product)}
              target="_blank"
              rel="noopener"
              class="mt-3 inline-block text-sm font-semibold text-cyan underline-offset-4 hover:underline"
              data-track="demo_click"
              data-section="penutup"
              data-sector={s.id}>Jadwalkan demo {s.tab}</a
            >
          </li>
        ))
      }
    </ul>
  </div>
</section>
