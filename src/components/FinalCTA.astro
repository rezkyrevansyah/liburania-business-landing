---
import { contactUrl, demoUrl, demoUrlFor, cta, price } from '../data/site';
import { sectors, sectorTone } from '../data/sectors';
import SectorIcon from './SectorIcon.astro';
---

<section id="konsultasi" data-final-cta aria-labelledby="final-title" class="on-dark bg-navy text-white">
  <div data-reveal="stagger" class="shell py-20 md:py-28">
    <div data-reveal-item style="--i:0" class="max-w-3xl">
      <p class="text-sm font-bold tracking-[0.08em] text-cyan">
        JELAS HARGANYA. JELAS FITURNYA. JELAS MANFAATNYA.
      </p>
      <h2 id="final-title" class="mt-5 text-[clamp(2.25rem,1.3rem+3.4vw,4rem)] font-[760] tracking-[-0.035em]">
        Jangan tunggu bisnis Anda semakin rumit untuk mulai menggunakan sistem.
      </h2>
      <p class="mt-6 max-w-[52ch] text-lg text-white/75">
        Mulai rapikan operasional bisnis Anda dengan sistem yang jelas fitur, jelas manfaat, dan jelas harganya.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener"
          class="btn btn-primary"
          data-track="demo_click"
          data-section="penutup">{cta.demo}</a
        >
        <a
          href={contactUrl}
          target="_blank"
          rel="noopener"
          class="btn btn-ghost-light"
          data-track="consult_click"
          data-section="penutup">{cta.consult}</a
        >
      </div>
    </div>
    <p data-reveal-item style="--i:1" class="mt-16 text-xl font-semibold md:mt-20">Pilih paket sesuai jenis usaha Anda</p>
    <ul class="mt-6 grid gap-5 lg:grid-cols-3">
      {
        sectors.map((s, idx) => (
          <li
            data-reveal-item="scale"
            style={`--i:${idx + 2}`}
            data-sector={s.id}
            class="price-card price-card--dark flex flex-col overflow-clip rounded-[var(--radius-panel)] border border-white/14 bg-navy-soft p-6 sm:p-7"
          >
            <span class:list={['inline-flex h-[30px] items-center gap-2 self-start rounded-full pr-3 pl-2.5 text-[0.8125rem] font-bold', sectorTone[s.id].tint, sectorTone[s.id].text]}>
              <SectorIcon id={s.id} class="size-[15px] shrink-0" />
              {s.tab}
            </span>
            <p class="mt-5 text-2xl leading-[1.25] font-bold tracking-[-0.015em]">{s.product}</p>
            <p class="mt-6 text-sm font-semibold text-white/70">Mulai dari</p>
            <p class="mt-1.5 flex flex-wrap items-end gap-x-2 gap-y-1">
              <span class="flex items-start gap-1">
                <span class="mt-[0.3em] text-xl leading-none font-bold">Rp</span>
                <span class="text-[clamp(3rem,1rem+10vw,3.75rem)] leading-none font-[800] tracking-[-0.045em] whitespace-nowrap tabular-nums lg:text-[clamp(3rem,6.6vw_-_1.5rem,3.75rem)]">{price.replace('Rp', '')}</span>
              </span>
              <span class="pb-1.5 leading-none font-medium text-white/70">/ bulan</span>
            </p>
            <a
              href={demoUrlFor(s.product)}
              target="_blank"
              rel="noopener"
              class="btn btn-light mt-7 min-h-13 w-full justify-between px-5"
              data-track="demo_click"
              data-section="penutup"
              data-sector={s.id}
            >
              Jadwalkan demo {s.product.replace('Liburania Business ', '')}
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
