---
import { contactUrl, contactUrlFor, cta, trustPoints } from '../data/site';
import { sectors } from '../data/sectors';
---

<section data-final-cta aria-labelledby="final-title" class="on-dark bg-navy text-white">
  <div class="shell py-20 md:py-28">
    <div class="max-w-3xl">
      <h2 id="final-title" class="text-[clamp(2.25rem,1.3rem+3.4vw,4rem)] font-[760] tracking-[-0.035em]">
        Siap melihat cara kerjanya untuk usaha Anda?
      </h2>
      <p class="mt-6 max-w-[52ch] text-lg text-white/75">
        Ceritakan kebutuhan F&B, retail, atau bisnis jasa Anda. Temukan solusi yang paling relevan bersama tim
        Liburania Business.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={contactUrl} class="btn btn-primary" data-track="demo_click" data-section="penutup">{cta.demo}</a>
        <a href={contactUrl} class="btn btn-ghost-light" data-track="sales_click" data-section="penutup"
          >{cta.sales}</a
        >
      </div>
      <p class="mt-6 text-sm text-white/65">{trustPoints.join(' · ')}</p>
    </div>
    <ul class="mt-16 grid gap-px overflow-hidden rounded-2xl bg-white/10 sm:grid-cols-3 md:mt-20">
      {
        sectors.map((s) => (
          <li class="bg-navy p-5 sm:p-6">
            <p class="font-bold">{s.product}</p>
            <p class="mt-1 text-sm text-white/65">{s.audience}</p>
            <a
              href={contactUrlFor(s.moduleCode)}
              class="mt-3 inline-block text-sm font-semibold text-cyan underline-offset-4 hover:underline"
              data-track="demo_click"
              data-section="penutup"
              data-sector={s.id}
              data-module={s.moduleCode}>Jadwalkan demo {s.tab}</a
            >
          </li>
        ))
      }
    </ul>
  </div>
</section>
