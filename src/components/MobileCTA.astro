---
import { demoUrl, cta } from '../data/site';
---

<!-- Tampil di ponsel setelah CTA hero keluar layar; disembunyikan saat penutup terlihat. -->
<div
  data-mobile-cta
  aria-hidden="true"
  inert
  class="fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-line bg-paper/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur-md transition-transform duration-300 ease-[var(--ease-out-soft)] data-[visible]:translate-y-0 md:hidden"
>
  <div class="mx-auto flex max-w-md gap-2">
    <a href={demoUrl} target="_blank" rel="noopener" class="btn btn-primary flex-1" data-track="demo_click" data-section="mobile-cta">{cta.demo}</a>
    <a href="#solusi" class="btn btn-quiet flex-1 bg-white px-3" data-track="solution_click" data-section="mobile-cta"
      >{cta.solutions}</a
    >
  </div>
</div>
