---
import { Picture } from 'astro:assets';
import { price, pricingUrlFor, reliability } from '../data/site';
import { sectors } from '../data/sectors';
---

<section id="harga" aria-labelledby="harga-title" class="py-16 md:py-24 lg:py-28">
  <div data-reveal class="shell">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
      <h2 id="harga-title" class="max-w-[19ch] text-[clamp(2rem,1.2rem+2.6vw,3.25rem)] font-[740]">
        Sudah tahu apa yang Anda dapatkan? Sekarang saatnya melihat harganya.
      </h2>
      <p class="max-w-md text-muted lg:pb-1.5">
        Mulai kelola bisnis secara lebih profesional tanpa biaya sistem yang berlebihan.
      </p>
    </div>

    <ul class="mt-10 grid gap-5 md:mt-14 md:grid-cols-3">
      {
        sectors.map((s) => (
          <li class="group flex flex-col overflow-clip rounded-[var(--radius-panel)] border border-line bg-white transition-[box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:shadow-[0_24px_50px_-30px_rgb(7_28_61/0.45)]">
            <div class="relative aspect-[16/10] overflow-clip bg-navy">
              <Picture
                src={s.ui}
                alt=""
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[480, 720, 960]}
                sizes="(min-width: 768px) 33vw, 100vw"
                class="h-full w-full object-cover object-left-top"
              />
              <span class="absolute top-3 left-3 rounded-full bg-cyan px-3 py-1 text-xs font-bold text-navy shadow-sm">
                {s.tab}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <p class="text-xl font-bold">{s.product}</p>
              <p class="mt-1.5 text-[0.9375rem] text-muted">{s.audience}</p>

              <div class="mt-7 border-t border-line pt-6">
                <p class="text-sm font-semibold text-muted">Mulai dari</p>
                <p class="mt-1 flex items-start gap-1 text-navy">
                  <span class="mt-[0.35em] text-xl font-bold">Rp</span>
                  <span class="text-[clamp(3.25rem,2.4rem+2.4vw,4.25rem)] leading-none font-[780] tracking-[-0.045em] tabular-nums">{price.replace('Rp', '')}</span>
                </p>
                <p class="mt-2 text-[0.9375rem] font-semibold text-blue-deep">per bulan</p>
              </div>

              <ul class="mt-6 flex-1 space-y-2.5 text-[0.9375rem]">
                {s.features.slice(0, 4).map((f) => (
                  <li class="flex items-center gap-2.5">
                    <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4 shrink-0 text-blue" fill="none" stroke="currentColor" stroke-width="2.4">
                      <path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    {f}
                  </li>
                ))}
                <li class="pl-6.5 text-muted">+ {s.features.length - 4} fitur lainnya</li>
              </ul>

              <a
                href={pricingUrlFor(s.product)}
                target="_blank"
                rel="noopener"
                class="btn btn-primary mt-7 w-full"
                data-track="pricing_click"
                data-section="harga"
                data-sector={s.id}>Konsultasikan paket</a
              >
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-muted">
      Bayar sesuai kebutuhan bisnis Anda. Jangan membayar mahal untuk fitur yang tidak digunakan.
    </p>

    <div class="mt-14 grid gap-8 rounded-[var(--radius-panel)] bg-white p-6 sm:p-8 md:mt-20 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14 lg:p-12">
      <h3 class="text-[clamp(1.625rem,1.1rem+1.5vw,2.375rem)] font-[720]">
        Teknologi bisnis tidak harus mahal. Tapi harus bisa diandalkan.
      </h3>
      <ul class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
        {
          reliability.map((item) => (
            <li class="flex items-start gap-3 font-medium">
              <svg
                aria-hidden="true"
                viewBox="0 0 20 20"
                class="mt-1 size-4 shrink-0 text-blue"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
              >
                <path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
