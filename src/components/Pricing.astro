---
import { Picture, getImage } from 'astro:assets';
import { price, pricingUrlFor, reliability } from '../data/site';
import { sectors, sectorTone as tone } from '../data/sectors';
import SectorIcon from './SectorIcon.astro';

// Versi besar untuk pop up; tidak memperbesar melebihi ukuran asli.
const zoomSrc = await Promise.all(
  sectors.map(async (s) => {
    const src = s.priceUi ?? s.ui;
    return (await getImage({ src, width: Math.min(src.width, 1600), format: 'webp' })).src;
  }),
);
---

<section id="harga" aria-labelledby="harga-title" class="py-16 md:py-24 lg:py-28">
  <div data-reveal="stagger" class="shell">
    <div data-reveal-item style="--i:0" class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
      <h2 id="harga-title" class="max-w-[19ch] text-[clamp(2rem,1.2rem+2.6vw,3.25rem)] font-[740]">
        Sudah tahu apa yang Anda dapatkan? Sekarang saatnya melihat harganya.
      </h2>
      <p class="max-w-md text-muted lg:pb-1.5">
        Mulai kelola bisnis secara lebih profesional tanpa biaya sistem yang berlebihan.
      </p>
    </div>

    <ul class="mx-auto mt-10 grid max-w-xl gap-5 md:mt-14 lg:max-w-none lg:grid-cols-3">
      {
        sectors.map((s, idx) => (
          <li
            data-reveal-item="scale"
            style={`--i:${idx + 1}`}
            data-sector={s.id}
            class="price-card group flex flex-col overflow-clip rounded-[var(--radius-panel)] border border-line bg-white shadow-[0_1px_2px_rgb(7_28_61/0.04),0_18px_40px_-18px_rgb(7_28_61/0.18)]"
          >
            <div class:list={['flex h-[17.5rem] flex-col gap-3 p-5', tone[s.id].tint]}>
              <span class:list={['inline-flex h-8 items-center gap-2 self-start rounded-full pr-3.5 pl-2.5 text-[0.8125rem] font-bold text-white', tone[s.id].solid]}>
                <SectorIcon id={s.id} class="size-4 shrink-0" />
                {s.tab}
              </span>
              <button
                type="button"
                class="flex min-h-0 flex-1 items-center justify-center rounded-[var(--radius-control)] [.js_&]:cursor-zoom-in"
                data-lightbox={zoomSrc[idx]}
                data-lightbox-alt={`Tampilan sistem ${s.product}`}
                aria-label={`Perbesar tampilan sistem ${s.product}`}
              >
                <Picture
                  src={s.priceUi ?? s.ui}
                  alt=""
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  widths={[480, 720, 960]}
                  sizes="(min-width: 1024px) 25vw, (min-width: 640px) 34rem, 100vw"
                  pictureAttributes={{ class: 'contents' }}
                  class="price-shot block h-auto max-h-[12.25rem] w-auto max-w-full rounded-[10px] border-3 border-white shadow-[0_2px_4px_rgb(7_28_61/0.06),0_16px_32px_-12px_rgb(7_28_61/0.3)]"
                />
              </button>
            </div>

            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <div class="lg:min-h-[6.5rem]">
                <p class="text-[1.375rem] leading-[1.3] font-bold tracking-[-0.01em]">{s.product}</p>
                <p class="mt-1.5 text-[0.9375rem] text-muted">{s.audience}</p>
              </div>

              <div class="mt-5">
                <p class="text-sm font-semibold text-muted">Mulai dari</p>
                <p class="mt-1.5 flex items-start gap-1.5 text-navy">
                  <span class="mt-[0.4em] text-[1.375rem] leading-none font-bold">Rp</span>
                  <span class="text-[clamp(3rem,1rem+12vw,4.75rem)] leading-none font-[800] tracking-[-0.045em] whitespace-nowrap tabular-nums lg:text-[clamp(3.5rem,9.3vw_-_2.125rem,4.75rem)]">{price.replace('Rp', '')}</span>
                </p>
                <p class:list={['mt-2 text-[0.9375rem] font-semibold', tone[s.id].text]}>per bulan</p>
              </div>

              <a
                href={pricingUrlFor(s.product)}
                target="_blank"
                rel="noopener"
                class="btn btn-primary mt-6 min-h-13 w-full shadow-[0_8px_18px_-8px_rgb(11_108_255/0.55)]"
                data-track="pricing_click"
                data-section="harga"
                data-sector={s.id}
              >
                Konsultasikan paket
                <svg aria-hidden="true" viewBox="0 0 24 24" class="size-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </a>

              <div class="mt-7 border-t border-line pt-6">
                <p class="text-xs font-bold tracking-[0.1em] text-muted uppercase">Termasuk</p>
                <ul class="mt-3 space-y-3 text-[0.9375rem] leading-[1.4]">
                  {s.features.slice(0, 4).map((f) => (
                    <li class="flex items-center gap-3">
                      <span class:list={['grid size-[22px] shrink-0 place-items-center rounded-full', tone[s.id].tint, tone[s.id].text]}>
                        <svg aria-hidden="true" viewBox="0 0 20 20" class="size-3" fill="none" stroke="currentColor" stroke-width="3">
                          <path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                      {f}
                    </li>
                  ))}
                  <li class:list={['pl-[34px] font-semibold', tone[s.id].text]}>+ {s.features.length - 4} fitur lainnya</li>
                </ul>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-muted">
      Bayar sesuai kebutuhan bisnis Anda. Jangan membayar mahal untuk fitur yang tidak digunakan.
    </p>

    <div data-reveal="" class="mt-14 grid gap-8 rounded-[var(--radius-panel)] bg-white p-6 sm:p-8 md:mt-20 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14 lg:p-12">
      <h3 class="text-[clamp(1.625rem,1.1rem+1.5vw,2.375rem)] font-[720]">
        Teknologi bisnis tidak harus mahal. Tapi harus bisa diandalkan.
      </h3>
      <ul class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
        {
          reliability.map((item) => (
            <li class="flex items-start gap-3 font-medium">
              <svg
                aria-hidden="true"
                viewBox="0 0 20 20"
                class="mt-1 size-4 shrink-0 text-blue"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
              >
                <path d="M4 10.5l4 4 8-9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Pop up screenshot: <dialog> bawaan browser (Esc menutup, fokus terkunci di dalam). -->
  <dialog data-lightbox-dialog aria-label="Tampilan sistem" class="lightbox m-auto max-w-[min(94vw,1200px)] overflow-visible bg-transparent p-0">
    <img alt="" class="block h-auto max-h-[86vh] w-auto max-w-full rounded-[var(--radius-control)] shadow-[0_30px_80px_-20px_rgb(0_0_0/0.6)]" />
    <form method="dialog">
      <button
        class="absolute -top-3 -right-3 grid size-11 place-items-center rounded-full bg-white text-navy shadow-lg transition-transform hover:scale-105"
        aria-label="Tutup"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </form>
  </dialog>
</section>
