---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Positioning from '../components/Positioning.astro';
import Pricing from '../components/Pricing.astro';
import BusinessTypes from '../components/BusinessTypes.astro';
import ProblemScenes from '../components/ProblemScenes.astro';
import SolutionExplorer from '../components/SolutionExplorer.astro';
import OwnerVisibility from '../components/OwnerVisibility.astro';
import DemoSteps from '../components/DemoSteps.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import MobileCTA from '../components/MobileCTA.astro';
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <Positioning />
    <ProblemScenes />
    <BusinessTypes />
    <SolutionExplorer />
    <OwnerVisibility />
    <Pricing />
    <DemoSteps />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
  <MobileCTA />
</Base>

<script>
  import '../scripts/page.ts';
</script>
